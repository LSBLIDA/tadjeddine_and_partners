---
import Layout from '../layouts/Layout.astro';
import '../styles/articles.css';
import { articles } from '../data/articles';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('fr');

const sortedArticles = [...articles].sort((a, b) => {
  return new Date(b.date_publication).getTime() - new Date(a.date_publication).getTime();
});
---

<Layout title={t('articles.title')}>
  <section class="articles-section">
    <h1 class="section-title">{t('articles.title')}</h1>
    <p class="section-subtitle">{t('articles.subtitle')}</p>

    {sortedArticles.length === 0 ? (
      <p class="no-articles">{t('articles.no_articles')}</p>
    ) : (
      <div class="articles-grid">
        {sortedArticles.map(article => (
          <div class="article-card">
            {article.image_couverture && (
              <div class="article-thumb">
                <img src={article.image_couverture} alt={article.title} />
              </div>
            )}
            <a href={`/articles/${article.slug}`} class="article-title">
              {article.title}
            </a>
            <p class="article-meta">
              ✍️ {article.author || t('articles.author_unknown')} | 📅 {article.date_publication || t('articles.date_unspecified')}
            </p>
            <p class="article-excerpt">
              {article.excerpt}
            </p>
            <a href={`/articles/${article.slug}`} class="read-more">{t('articles.read_article')}</a>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
