---
import Layout from '../layouts/Layout.astro';
import '../styles/services.css';


---

<Layout title="Nos Services">
  <section id="services" class="services">
    <div class="container">
      <h2 class="section-title">Nos Services</h2>
      <p class="section-subtitle">
        Des solutions complètes et personnalisées pour accompagner votre entreprise dans sa croissance et sa transformation
      </p>

      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon"><i class="fas fa-balance-scale"></i></div>
          <h3>Conformité à la loi 18-07</h3>
          <ul class="service-list">
            <li>Audit et diagnostic de conformité</li>
            <li>Cartographie des traitements de données</li>
            <li>Mise en place de politiques conformes</li>
            <li>Assistance à la déclaration ANPDP</li>
            <li>Formation des équipes</li>
            <li>Accompagnement continu</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon"><i class="fas fa-graduation-cap"></i></div>
          <h3>Formation & Conseil</h3>
          <ul class="service-list">
            <li>Sensibilisation des employés</li>
            <li>Formation des DPO</li>
            <li>Ateliers pratiques loi 18-07</li>
            <li>Responsables de conformité</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon"><i class="fas fa-chart-line"></i></div>
          <h3>Audit Commercial</h3>
          <ul class="service-list">
            <li>Diagnostic des stratégies commerciales</li>
            <li>Analyse des performances</li>
            <li>Évaluation des outils CRM</li>
            <li>Benchmarking concurrentiel</li>
            <li>Plan d'action commercial</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon"><i class="fas fa-rocket"></i></div>
          <h3>Transformation Agile</h3>
          <ul class="service-list">
            <li>Audit des pratiques actuelles</li>
            <li>Méthodologies agiles (Scrum, Kanban)</li>
            <li>Mise en place du PMO</li>
            <li>Coaching des équipes</li>
            <li>Formation gestion de projet</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon"><i class="fas fa-users"></i></div>
          <h3>Stratégies RH</h3>
          <ul class="service-list">
            <li>Audit RH et diagnostic organisationnel</li>
            <li>Politiques RH et conformité</li>
            <li>Recrutement et gestion des talents</li>
            <li>Formation management et soft skills</li>
            <li>Optimisation des rémunérations</li>
          </ul>
        </div>

        <div class="service-card">
          <div class="service-icon"><i class="fas fa-laptop"></i></div>
          <h3>Solutions ERP & CRM</h3>
          <ul class="service-list">
            <li>Conception de cahiers des charges</li>
            <li>Conseil et choix d'ERP adapté</li>
            <li>Intégration et paramétrage</li>
            <li>Déploiement de solutions CRM</li>
            <li>Support et maintenance</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-icon {
    font-size: 2rem;
    color: #ccc; /* Monochrome gris clair */
    margin-bottom: 1rem;
  }
</style>
