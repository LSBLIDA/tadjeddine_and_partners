---
import Layout from '../../layouts/Layout.astro';
import '../../styles/publication-details.css';

export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.PUBLIC_STRAPI_URL}/api/publications?populate=*`);
  const { data } = await res.json();

  return data
    .filter(pub => pub?.Slug)
    .map(pub => ({
      params: { slug: pub.Slug },
      props: { publication: pub },
    }));
}

const { publication } = Astro.props;
---

<Layout title={publication?.Titre || "Publication"}>
  <main class="publication-detail-grid">
    
    <!-- Colonne gauche -->
    <div>
      <!-- 🔙 Lien retour placé AU-DESSUS du cadre -->
      <div class="back-to-publications">
        <a href="/publications">
          <i class="fas fa-arrow-left"></i> Voir toutes les publications
        </a>
      </div>

      <div class="publication-card publication-left">
        {publication.Image_couverture?.url && (
          <img
            src={`${import.meta.env.PUBLIC_STRAPI_URL}${publication.Image_couverture.url}`}
            alt={publication.Titre}
            class="publication-img"
          />
        )}

        {publication.Prix > 0 ? (
          <>
            <p class="publication-price">{publication.Prix} DA HT</p>

            {/* 🔹 Extrait AU-DESSUS du bouton Ecwid (inline style pour forcer le doré) */}
            {publication.Apercu?.url && (
              <div class="extrait-wrapper">
                <a
                  href={`${import.meta.env.PUBLIC_STRAPI_URL}${publication.Apercu.url}`}
                  class="extrait-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:#d4af37 !important; text-decoration:none !important; font-weight:400 !important;"
                >
                  ↩ Lire un extrait du document
                </a>
              </div>
            )}

            {/* 🔹 Ecwid en dessous */}
            <div class="btn-group">
              <div class="publication-ecwid" set:html={publication.Bouton_Ecwid}></div>
            </div>
          </>
        ) : (
          <>
            <p class="publication-price">Gratuit</p>

            {/* 🔹 Extrait AU-DESSUS du bouton Télécharger */}
            {publication.Apercu?.url && (
              <div class="extrait-wrapper">
                <a
                  href={`${import.meta.env.PUBLIC_STRAPI_URL}${publication.Apercu.url}`}
                  class="extrait-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color:#d4af37 !important; text-decoration:none !important; font-weight:400 !important;"
                >
                  ↩ Lire un extrait du document
                </a>
              </div>
            )}

            {/* 🔹 Télécharger en dessous */}
            {publication.Fichier?.url && (
              <div class="btn-group">
                <a
                  href={`${import.meta.env.PUBLIC_STRAPI_URL}${publication.Fichier.url}`}
                  class="download-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Télécharger
                </a>
              </div>
            )}
          </>
        )}
      </div>
    </div>

    <!-- Colonne droite -->
    <div class="publication-card publication-right">
      <h1 class="section-title">{publication.Titre}</h1>
      <p class="publication-meta">
        <strong>Date de mise en ligne :</strong> {publication.Date_mise_en_ligne}
      </p>

      <div class="publication-content">
        {publication.Description?.map((block) => (
          <p>{block.children.map(child => child.text).join(" ")}</p>
        ))}
      </div>
    </div>

  </main>
</Layout>
