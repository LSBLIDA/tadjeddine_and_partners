---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import '../styles/livre.css';

const t = useTranslations('fr');
---

<Layout title={t('livre.title')}>
  <Fragment slot="head">
    <meta name="description" content={t('livre.subtitle')} />
    <meta property="og:title" content={t('livre.title')} />
    <meta property="og:description" content={t('livre.subtitle')} />
    <meta property="og:image" content="https://tadjeddine-partners.com/uploads/livre-e-gouvernement-couverture.png" />
    <link rel="canonical" href="https://tadjeddine-partners.com/livre/" />
  </Fragment>

  <div class="livre-page">
    <div class="livre-container">
      <header class="livre-header">
        <div class="livre-header-title-container">
          <svg class="livre-header-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
          <h1 class="livre-h1">{t('livre.title')}</h1>
        </div>
        <p class="livre-subtitle">{t('livre.subtitle')}</p>
        <p class="livre-preface">{t('livre.preface')}</p>
        <div class="livre-top-actions">
          <button id="open-modal-btn" class="livre-btn livre-btn-primary">
            <svg class="w-5 h-5" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            {t('livre.buy_algeria')}
          </button>
          <a href="https://www.amazon.fr/GOUVERNEMENT-EN-ALGERIE-OBSTACLES-SOLUTIONS-ebook/dp/B0C3WK3D9N/" target="_blank" rel="noopener noreferrer" class="livre-btn livre-btn-secondary">
            <svg class="w-5 h-5" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            {t('livre.buy_amazon')}
          </a>
          <a href="https://drive.google.com/file/d/1yfmlTlycbm8yu71LxPHtAAtSeOvAjzFI/view" target="_blank" rel="noopener noreferrer" class="livre-btn-blue">
            <svg class="w-5 h-5" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            {t('livre.preview_button')}
          </a>
        </div>
      </header>

      <div class="livre-grid">
        <div class="livre-col-left">
          <div class="livre-card-cover">
            <div class="livre-cover-wrapper">
              <img src="/uploads/livre-e-gouvernement-couverture.png" alt="e-Gouvernement couverture" class="livre-cover-img" />
            </div>
          </div>
        </div>
        
        <div class="livre-col-right">
          <div class="livre-content-box">
             <h3 class="livre-h3">{t('livre.content_title')}</h3>
             <div class="livre-text">
               <blockquote class="livre-quote">{t('livre.quote')}</blockquote>
               <p>{t('livre.paragraph_1')}</p>
               <p>{t('livre.paragraph_2')}</p>
             </div>
          </div>
          <div class="livre-author-box">
             <h3>{t('livre.author_title')}</h3>
             <p>{t('livre.author_bio')}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Modal Fenekio -->
    <div id="quote-modal" class="livre-modal-overlay">
      <div class="livre-modal-content">
         <button id="close-modal-btn" class="livre-modal-close" aria-label={t('livre.close_modal')}>
           &times;
         </button>
         <div class="livre-modal-body">
           <iframe class="livre-iframe" height="850" src="https://fenekio.com/tandp/ps/forms/quote/f74a06ff758a0effa517626c41cfbd92" frameBorder="0" sandbox="allow-top-navigation allow-forms allow-scripts allow-same-origin allow-popups" allowFullScreen></iframe>
         </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const openBtn = document.getElementById("open-modal-btn");
      const closeBtn = document.getElementById("close-modal-btn");
      const modal = document.getElementById("quote-modal");

      if(openBtn && closeBtn && modal) {
        openBtn.addEventListener("click", () => {
          modal.classList.add("active");
          document.body.style.overflow = "hidden";
        });

        closeBtn.addEventListener("click", () => {
          modal.classList.remove("active");
          document.body.style.overflow = "";
        });

        modal.addEventListener("click", (e) => {
          if (e.target === modal) {
            modal.classList.remove("active");
            document.body.style.overflow = "";
          }
        });
      }
    });
  </script>
</Layout>
