---
export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } }
  ];
}
const { lang } = Astro.params;

import Layout from '../../layouts/Layout.astro';
import '../../styles/publications.css';
import { publications } from '../../data/publications';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations(lang);

const sortedPublications = [...publications].sort((a, b) => {
  return new Date(b.date_mise_en_ligne).getTime() - new Date(a.date_mise_en_ligne).getTime();
});
---

<Layout title={t('publications.title')}>
  <section class="publications-section container">
    <h1 class="section-title"><i class="fas fa-book"></i> {t('publications.title')}</h1>
    <p class="section-subtitle">{t('publications.subtitle')}</p>

    {sortedPublications.length === 0 ? (
      <p class="no-publications">{t('publications.no_publications')}</p>
    ) : (
      <div class="publications-grid">
        {sortedPublications.map(pub => (
          <a href={`/${lang}/publications/${pub.slug}`} class="publication-card">
            {pub.image_couverture && (
              <img 
                src={pub.image_couverture} 
                alt={pub[`title_${lang}` as keyof typeof pub] || pub.title} 
                class="publication-img"
              />
            )}

            <h2 class="publication-title">
              <i class="fas fa-file-alt"></i> {pub[`title_${lang}` as keyof typeof pub] || pub.title || "Sans titre"}
            </h2>
            <p class="publication-meta">
              <i class="fas fa-calendar-alt"></i> {pub.display_date || pub.date_mise_en_ligne || "Date inconnue"} 
              &nbsp;|&nbsp; 
              <i class="fas fa-tag"></i> {pub.is_free ? t('publications.free') : (pub.prix ? (typeof pub.prix === 'string' ? pub.prix : pub.prix + " DA") : t('publications.free'))}
            </p>
            <p class="publication-excerpt">
              {pub[`excerpt_${lang}` as keyof typeof pub] || pub.excerpt || ((pub[`description_${lang}` as keyof typeof pub] || pub.description)?.[0]?.slice(0, 120) + "...") || ""}
            </p>
            <span class="read-more">
              <i class="fas fa-arrow-right"></i> {t('publications.read_more')}
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
